#!/bin/bash
#
# /etc/grub.d/99_grub_icon_menu - grub-icon-menu hook for grub-mkconfig
#
# Appends an icon-only boot chooser to the END of grub.cfg.
#
# How it works (details in README.md):
#   1. grub-mkconfig runs every /etc/grub.d script in order and writes their
#      output to grub.cfg.new. Running last, this script reads that partial
#      file, i.e. exactly the menu entries the other scripts just generated.
#   2. Every entry is classified from what it *does*, not from its title:
#        windows : chainloads .../EFI/Microsoft/Boot/bootmgfw.efi
#        linux   : loads a Linux kernel (vmlinuz*) generated by 10_linux*
#                  (this Ubuntu: the Tux icon)
#        kali, linuxmint, arch, fedora, ... (gim_os_kind): another Linux
#                  found by os-prober, when GRUB_ICON_MENU_FOREIGN_LINUX=true
#        other   : everything else (memtest, firmware setup, custom
#                  entries) - ignored by the chooser
#      All entries of one kind are grouped behind a single icon.
#   5. Other systems with their own UEFI boot entry (Kali, Fedora, Arch, ...)
#      get an icon too and are started by the firmware, like Windows (see
#      "Other systems through the firmware").
#   3. It emits GRUB script that, at boot, opens a nested menu holding one
#      entry per detected kind (rendered as icons only by the theme). Picking
#      an icon re-enters grub.cfg with that kind's target entry as default and
#      a zero timeout, so the *standard* entry boots - recordfail, savedefault,
#      fallback and recovery behaviour stay exactly as Ubuntu generated them.
#      ESC in the chooser shows the full standard menu.
#   4. Windows (GRUB_ICON_MENU_WINDOWS_BOOT=firmware, the default): the icon
#      does not chainload Windows Boot Manager, because BitLocker then asks
#      for the recovery key. It boots an entry added here that lets the UEFI
#      firmware start Windows instead (see "Windows through the firmware").
#
# Safety contract: this script never makes update-grub fail and never emits
# partial output. On any problem it prints a comment instead, and grub.cfg is
# exactly what the other scripts produced (the normal Ubuntu menu).
#
# Library mode: GIM_HOOK_LIB=1 only defines the functions (used by
# detect-os.sh, generate-menu.sh and the test-suite).

GIM_VERSION="1.3.0"
GIM_HOOK_NAME="99_grub_icon_menu"
GIM_THEME_MARKER=".grub-icon-menu"      # file in every theme directory we made
# Every kind this version understands: windows, linux (this Ubuntu) and the
# systems of gim_os_kind (icons/png/<kind>.png). At most GIM_MAX_ICONS icons.
GIM_ALL_KINDS="windows linux kali linuxmint arch debian fedora opensuse manjaro ubuntu
 popos elementary zorin endeavouros centos rocky almalinux redhat gentoo nixos mxlinux
 kubuntu xubuntu lubuntu ubuntumate garuda void alpine slackware solus deepin parrot
 qubes freebsd kdeneon artix cachyos android generic"
GIM_ALL_KINDS="$(printf '%s' "$GIM_ALL_KINDS" | tr -s ' \n' ' ')"
GIM_MAX_ICONS=6
GIM_US=$'\037'                         # field separator of parser records

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# Read GRUB_ICON_MENU_* settings. grub-mkconfig does not export custom
# variables to its helper scripts, so source the same files it sources
# (/etc/default/grub, then /etc/default/grub.d/*.cfg) in a subshell.
gim_load_config() {
    local sysconf="${GIM_SYSCONFDIR:-/etc}"
    local settings
    settings="$(
        set +eu
        if [ -f "$sysconf/default/grub" ]; then
            . "$sysconf/default/grub" >/dev/null 2>&1
        fi
        for f in "$sysconf"/default/grub.d/*.cfg; do
            if [ -e "$f" ]; then . "$f" >/dev/null 2>&1; fi
        done
        for v in GRUB_ICON_MENU GRUB_ICON_MENU_TIMEOUT GRUB_ICON_MENU_THEME_DIR \
                 GRUB_ICON_MENU_ORDER GRUB_ICON_MENU_RESCAN \
                 GRUB_ICON_MENU_FOREIGN_LINUX GRUB_ICON_MENU_WINDOWS_BOOT \
                 GRUB_ICON_MENU_FIRMWARE_SYSTEMS GRUB_RECORDFAIL_TIMEOUT; do
            printf 'CFG_%s=%q\n' "$v" "${!v-}"
        done
    )" || return 1
    eval "$settings"

    GIM_ENABLED="${CFG_GRUB_ICON_MENU:-true}"
    GIM_TIMEOUT="${CFG_GRUB_ICON_MENU_TIMEOUT:-10}"
    GIM_THEME_DIR="${CFG_GRUB_ICON_MENU_THEME_DIR:-/boot/grub/themes/grub-icon-menu}"
    GIM_ORDER="${CFG_GRUB_ICON_MENU_ORDER:-$GIM_ALL_KINDS}"
    GIM_RESCAN="${CFG_GRUB_ICON_MENU_RESCAN:-true}"
    GIM_FOREIGN_LINUX="${CFG_GRUB_ICON_MENU_FOREIGN_LINUX:-false}"
    GIM_WINDOWS_BOOT="${CFG_GRUB_ICON_MENU_WINDOWS_BOOT:-firmware}"
    GIM_FIRMWARE_SYSTEMS="${CFG_GRUB_ICON_MENU_FIRMWARE_SYSTEMS:-true}"
    GIM_RECORDFAIL_TIMEOUT="${CFG_GRUB_RECORDFAIL_TIMEOUT:-30}"

    case "$GIM_TIMEOUT" in
        -1|0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
        *) gim_warn "invalid GRUB_ICON_MENU_TIMEOUT '$GIM_TIMEOUT', using 10"
           GIM_TIMEOUT=10 ;;
    esac
    case "$GIM_RECORDFAIL_TIMEOUT" in
        -1|[0-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;;
        *) GIM_RECORDFAIL_TIMEOUT=30 ;;
    esac
    case "$GIM_WINDOWS_BOOT" in
        firmware|chainload) ;;
        *) gim_warn "invalid GRUB_ICON_MENU_WINDOWS_BOOT '$GIM_WINDOWS_BOOT', using firmware"
           GIM_WINDOWS_BOOT=firmware ;;
    esac
    return 0
}

gim_warn() { echo "grub-icon-menu: $*" >&2; }

# Platform the menu will run on: decides which platform-conditional entries
# (if [ "$grub_platform" = "efi" ] ...) exist at boot.
gim_detect_platform() {
    if [ -n "${GIM_PLATFORM:-}" ]; then return 0; fi
    if [ -d /sys/firmware/efi ]; then
        GIM_PLATFORM=efi
        if [ "$(cat /sys/firmware/efi/fw_platform_size 2>/dev/null)" = 32 ]; then
            GIM_CPU=i386
        else
            GIM_CPU=x86_64
        fi
    else
        GIM_PLATFORM=pc
        GIM_CPU=i386
    fi
}

# ---------------------------------------------------------------------------
# Parser: grub.cfg text (stdin) -> one record per menuentry/submenu (stdout)
# ---------------------------------------------------------------------------
#
# Record fields (separated by \037):
#   seq parent type depth presence idx_path idx_certain id_path title_path
#   own_idx own_id own_title classes script kernel chain
#
# presence: T = always exists, U = depends on a runtime condition,
#           F = never exists on this platform (e.g. BIOS-only entries on EFI).
# Parsing stops at this hook's own section, so a fully generated grub.cfg can
# be analysed too.
gim_parse() {
    awk -v PLATFORM="${GIM_PLATFORM:-efi}" -v CPU="${GIM_CPU:-x86_64}" \
        -v SELF="$GIM_HOOK_NAME" -v US="$GIM_US" '
    # ---- shell-like tokenizer (single/double quotes, backslash escapes) ----
    function tokenize(s, toks,    n, i, c, cur, inq, have) {
        n = 0; cur = ""; inq = ""; have = 0
        for (i = 1; i <= length(s); i++) {
            c = substr(s, i, 1)
            if (inq == "\047") {
                if (c == "\047") inq = ""; else cur = cur c
            } else if (inq == "\"") {
                if (c == "\\" && i < length(s)) { i++; cur = cur substr(s, i, 1) }
                else if (c == "\"") inq = ""
                else cur = cur c
            } else if (c == "\047" || c == "\"") {
                inq = c; have = 1
            } else if (c == "\\" && i < length(s)) {
                i++; cur = cur substr(s, i, 1); have = 1
            } else if (c == " " || c == "\t") {
                if (have) { toks[++n] = cur; cur = ""; have = 0 }
            } else if (c == "#" && !have) {
                break
            } else {
                cur = cur c; have = 1
            }
        }
        if (have) toks[++n] = cur
        return n
    }
    function esc_path(s) { gsub(/>/, ">>", s); return s }
    function clean(s) { gsub(US, " ", s); gsub(/\t/, " ", s); return s }
    # ---- if/fi tracking (menu context only) ----
    function eval_cond(c,    nparts, parts, i, p, r, st, a, b, op) {
        gsub(/["\047]/, "", c); gsub(/\[|\]/, "", c)
        nparts = split(c, parts, / -a /)
        r = "T"
        for (i = 1; i <= nparts; i++) {
            p = parts[i]; sub(/^[ \t]+/, "", p); sub(/[ \t]+$/, "", p)
            st = "U"
            if (match(p, /^x?\$\{?grub_(platform|cpu)\}?[ \t]+!?=[ \t]+x?[A-Za-z0-9_]+$/)) {
                a = p; sub(/[ \t].*$/, "", a)
                b = p; sub(/^.*[ \t]/, "", b)
                # the x$var = xvalue idiom: strip the x only when both sides use it
                if (a ~ /^x/) sub(/^x/, "", b)
                op = (p ~ /!=/) ? "!=" : "="
                if (a ~ /platform/) st = (b == PLATFORM) ? "T" : "F"
                else st = (b == CPU) ? "T" : "F"
                if (op == "!=") st = (st == "T") ? "F" : "T"
            }
            if (st == "F") return "F"
            if (st == "U") r = "U"
        }
        return r
    }
    function scan_if_words(t,    n, w, i) {
        n = split(t, w, /[ \t;]+/)
        for (i = 1; i <= n; i++) {
            if (w[i] == "") continue
            if (capturing) {
                if (w[i] == "then") {
                    if (capturing == 2) ifst[nif] = "U"
                    else ifst[++nif] = eval_cond(cond)
                    capturing = 0
                } else cond = cond " " w[i]
                continue
            }
            if (w[i] == "if") { capturing = 1; cond = "" }
            else if (w[i] == "elif") { capturing = 2; cond = "" }
            else if (w[i] == "else") {
                if (nif > 0) ifst[nif] = (ifst[nif] == "T") ? "F" : (ifst[nif] == "F") ? "T" : "U"
            } else if (w[i] == "fi") { if (nif > 0) nif-- }
        }
    }
    function presence(    i, r) {
        r = "T"
        for (i = 1; i <= nif; i++) {
            if (ifst[i] == "F") return "F"
            if (ifst[i] == "U") r = "U"
        }
        return r
    }
    # ---- frames: menu levels, entry bodies, functions, plain blocks ----
    function open_item(type, toks, ntok,    i, title, id, classes, m, pres, idx) {
        title = ""; id = ""; classes = ""
        for (i = 2; i <= ntok; i++) {
            if (toks[i] == "{") break
            if (toks[i] == "--class") { classes = classes " " toks[++i]; continue }
            if (toks[i] ~ /^--class=/) { classes = classes " " substr(toks[i], 9); continue }
            if (toks[i] == "--id" || toks[i] == "$menuentry_id_option" || toks[i] == "${menuentry_id_option}") { id = toks[++i]; continue }
            if (toks[i] ~ /^--id=/) { id = substr(toks[i], 6); continue }
            if (toks[i] == "--users" || toks[i] == "--hotkey" || toks[i] == "--source") { i++; continue }
            if (toks[i] ~ /^--/) continue
            if (title == "") title = toks[i]
        }
        sub(/^ /, "", classes)
        m = menu_top
        pres = presence()
        seq++
        if (pres == "F") {
            idx = ""
        } else {
            idx = mnext[m]; mnext[m]++
        }
        rec_parent[seq] = mseq[m]; rec_type[seq] = type; rec_depth[seq] = mdepth[m]
        rec_pres[seq] = pres; rec_cert[seq] = mcert[m]
        rec_idx[seq] = idx; rec_id[seq] = id; rec_title[seq] = title
        rec_classes[seq] = classes; rec_script[seq] = script
        rec_kernel[seq] = ""; rec_chain[seq] = ""
        if (pres == "F") { rec_idxp[seq] = "" }
        else rec_idxp[seq] = (mpath_idx[m] == "") ? idx : mpath_idx[m] ">" idx
        if (pres == "U") mcert[m] = 0
        rec_idp[seq] = (id == "" || mpath_idok[m] == 0) ? "" : ((mpath_id[m] == "") ? esc_path(id) : mpath_id[m] ">" esc_path(id))
        rec_titlep[seq] = (mpath_title[m] == "") ? esc_path(title) : mpath_title[m] ">" esc_path(title)
        if (type == "submenu") {
            emit(seq)
            menu_top++
            mseq[menu_top] = seq; mdepth[menu_top] = mdepth[m] + 1
            mnext[menu_top] = 0; mcert[menu_top] = (pres == "T" && rec_cert[seq]) ? 1 : 0
            mpath_idx[menu_top] = rec_idxp[seq]; mpath_title[menu_top] = rec_titlep[seq]
            mpath_id[menu_top] = rec_idp[seq]; mpath_idok[menu_top] = (rec_idp[seq] != "")
            push("submenu")
        } else {
            cur_entry = seq
            push("entry")
        }
    }
    function emit(s) {
        printf "%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n",
            s, US, rec_parent[s], US, rec_type[s], US, rec_depth[s], US, rec_pres[s], US,
            (rec_idxp[s] == "" ? "-" : rec_idxp[s]), US, rec_cert[s], US,
            (rec_idp[s] == "" ? "-" : clean(rec_idp[s])), US, clean(rec_titlep[s]), US,
            (rec_idx[s] == "" ? "-" : rec_idx[s]), US,
            (rec_id[s] == "" ? "-" : clean(rec_id[s])), US, clean(rec_title[s]), US,
            (rec_classes[s] == "" ? "-" : rec_classes[s]), US, (rec_script[s] == "" ? "-" : rec_script[s]), US,
            (rec_kernel[s] == "" ? "-" : clean(rec_kernel[s])), US, (rec_chain[s] == "" ? "-" : clean(rec_chain[s]))
    }
    function push(kind) { stack[++sp] = kind }
    function in_entry(    i) { for (i = sp; i >= 1; i--) if (stack[i] == "entry") return 1; return 0 }
    BEGIN {
        sp = 0; menu_top = 1; mseq[1] = 0; mdepth[1] = 0; mnext[1] = 0; mcert[1] = 1
        mpath_idx[1] = ""; mpath_id[1] = ""; mpath_title[1] = ""; mpath_idok[1] = 1
        nif = 0; capturing = 0; seq = 0; script = ""; pending = ""; stop = 0
    }
    stop { next }
    /^### BEGIN / {
        script = $0; sub(/^### BEGIN /, "", script); sub(/ ###.*$/, "", script)
        n = split(script, sp_parts, "/"); script = sp_parts[n]
        if (script == SELF) stop = 1
        next
    }
    {
        t = $0; sub(/^[ \t]+/, "", t); sub(/[ \t]+$/, "", t)
        if (t == "" || substr(t, 1, 1) == "#") next
        top = (sp > 0) ? stack[sp] : "menu"
        if (top == "entry" || top == "func" || top == "block") {
            if (t ~ /^}[ \t]*(;[ \t]*)?$/) {
                if (top == "entry" && cur_entry > 0) { emit(cur_entry); cur_entry = 0 }
                sp--
                next
            }
            if (t ~ /\{$/) push("block")
            if (in_entry() && cur_entry > 0) {
                if (rec_kernel[cur_entry] == "" && t ~ /^(linux|linuxefi|linux16)[ \t]/) {
                    ntok = tokenize(t, tk); if (ntok >= 2) rec_kernel[cur_entry] = tk[2]
                }
                if (rec_chain[cur_entry] == "" && t ~ /^chainloader[ \t]/) {
                    ntok = tokenize(t, tk)
                    for (k = 2; k <= ntok; k++) if (tk[k] !~ /^-/) { rec_chain[cur_entry] = tk[k]; break }
                }
            }
            next
        }
        # ---- menu context ----
        if (pending != "") {
            if (t == "{") { ntok = tokenize(pending, tk); open_item(ptype, tk, ntok) }
            pending = ""
            next
        }
        if (t ~ /^(menuentry|submenu)[ \t]/) {
            ptype = (t ~ /^submenu/) ? "submenu" : "entry"
            if (t ~ /\{$/) { ntok = tokenize(t, tk); open_item(ptype, tk, ntok) }
            else pending = t
            next
        }
        if (t ~ /^function[ \t]/) { if (t ~ /\{$/) push("func"); next }
        if (t ~ /^}[ \t]*(;[ \t]*)?$/) {
            if (sp > 0 && stack[sp] == "submenu") { sp--; menu_top-- }
            next
        }
        scan_if_words(t)
    }'
}

# ---------------------------------------------------------------------------
# Classification
# ---------------------------------------------------------------------------

# Load parser records (stdin) into REC_* arrays and classify them.
# Results (globals):
#   GIM_KINDS        detected kinds, in display order (subset of GIM_ORDER)
#   GIM_TARGET_<k>   GRUB entry path booted by the icon of kind k
#   GIM_HEADS_<k>    newline-separated top-level idx/id/title values of kind k
#   GIM_FALLBACK_KIND kind preselected when $default matches nothing
#   GIM_COUNT_*      statistics; GIM_REPORT human readable table
gim_classify() {
    local line seq
    REC_SEQ=(); REC_PARENT=(); REC_TYPE=(); REC_DEPTH=(); REC_PRES=()
    REC_IDXP=(); REC_CERT=(); REC_IDP=(); REC_TITLEP=(); REC_IDX=(); REC_ID=()
    REC_TITLE=(); REC_CLASSES=(); REC_SCRIPT=(); REC_KERNEL=(); REC_CHAIN=()
    REC_KIND=()
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        local f
        IFS="$GIM_US" read -r -a f <<<"$line"
        [ "${#f[@]}" -ge 16 ] || continue
        seq="${f[0]}"
        REC_SEQ+=("$seq")
        REC_PARENT[$seq]="${f[1]}"; REC_TYPE[$seq]="${f[2]}"; REC_DEPTH[$seq]="${f[3]}"
        REC_PRES[$seq]="${f[4]}";   REC_IDXP[$seq]="${f[5]}"; REC_CERT[$seq]="${f[6]}"
        REC_IDP[$seq]="${f[7]}";    REC_TITLEP[$seq]="${f[8]}"; REC_IDX[$seq]="${f[9]}"
        REC_ID[$seq]="${f[10]}";    REC_TITLE[$seq]="${f[11]}"; REC_CLASSES[$seq]="${f[12]}"
        REC_SCRIPT[$seq]="${f[13]}"; REC_KERNEL[$seq]="${f[14]}"; REC_CHAIN[$seq]="${f[15]}"
    done

    # 1. entries: classify by what they boot
    for seq in "${REC_SEQ[@]}"; do
        [ "${REC_TYPE[$seq]}" = entry ] || continue
        REC_KIND[$seq]="$(gim_entry_kind "$seq")"
    done
    # 2. submenus: the single kind of their classified descendants, else other
    local i
    for (( i=${#REC_SEQ[@]}-1; i>=0; i-- )); do
        seq="${REC_SEQ[$i]}"
        [ "${REC_TYPE[$seq]}" = submenu ] || continue
        local kinds="" c
        for c in "${REC_SEQ[@]}"; do
            gim_is_descendant "$c" "$seq" || continue
            case "${REC_KIND[$c]:-}" in
                ""|other|absent) ;;
                *) case " $kinds " in *" ${REC_KIND[$c]} "*) ;; *) kinds="$kinds ${REC_KIND[$c]}" ;; esac ;;
            esac
        done
        kinds="${kinds# }"
        case "$kinds" in
            ""|*" "*) REC_KIND[$seq]=other ;;
            *)        REC_KIND[$seq]="$kinds" ;;
        esac
        [ "${REC_PRES[$seq]}" = F ] && REC_KIND[$seq]=absent
    done

    # 3. group per kind
    local k
    GIM_KINDS=""
    GIM_COUNT_TOTAL=0; GIM_COUNT_IGNORED=0; GIM_COUNT_ABSENT=0
    for k in $GIM_ALL_KINDS; do
        eval "GIM_TARGET_$k=''; GIM_HEADS_$k=''; GIM_COUNT_$k=0"
    done
    for seq in "${REC_SEQ[@]}"; do
        [ "${REC_TYPE[$seq]}" = entry ] || continue
        GIM_COUNT_TOTAL=$((GIM_COUNT_TOTAL + 1))
        case "${REC_KIND[$seq]}" in
            absent) GIM_COUNT_ABSENT=$((GIM_COUNT_ABSENT + 1)) ;;
            other)  GIM_COUNT_IGNORED=$((GIM_COUNT_IGNORED + 1)) ;;
            *)      eval "GIM_COUNT_${REC_KIND[$seq]}=\$((GIM_COUNT_${REC_KIND[$seq]} + 1))" ;;
        esac
    done
    for k in $GIM_ORDER; do
        case " $GIM_ALL_KINDS " in *" $k "*) ;; *) gim_warn "unknown kind '$k' in GRUB_ICON_MENU_ORDER ignored" ;; esac
    done
    # GRUB_ICON_MENU_ORDER first, then every other kind that was found.
    for k in $GIM_ORDER $GIM_ALL_KINDS; do
        case " $GIM_ALL_KINDS " in *" $k "*) ;; *) continue ;; esac
        case " $GIM_KINDS " in *" $k "*) continue ;; esac
        local n target="" heads=""
        eval "n=\$GIM_COUNT_$k"
        [ "$n" -gt 0 ] || continue
        # target: first top-level entry of this kind, else first nested one
        for seq in "${REC_SEQ[@]}"; do
            if [ "${REC_TYPE[$seq]}" = entry ] && [ "${REC_KIND[$seq]}" = "$k" ] && [ "${REC_DEPTH[$seq]}" = 0 ]; then
                target="$(gim_entry_path "$seq")"; break
            fi
        done
        if [ -z "$target" ]; then
            for seq in "${REC_SEQ[@]}"; do
                if [ "${REC_TYPE[$seq]}" = entry ] && [ "${REC_KIND[$seq]}" = "$k" ]; then
                    target="$(gim_entry_path "$seq")"; break
                fi
            done
        fi
        [ -n "$target" ] || continue
        # matches: every way $default can name an item of this kind (index,
        # id or title path, as GRUB_DEFAULT / saved_entry may use any form)
        for seq in "${REC_SEQ[@]}"; do
            [ "${REC_KIND[$seq]}" = "$k" ] || continue
            if [ "${REC_IDXP[$seq]}" != - ] && [ "${REC_CERT[$seq]}" = 1 ]; then heads="$heads${REC_IDXP[$seq]}"$'\n'; fi
            if [ "${REC_IDP[$seq]}" != - ]; then heads="$heads${REC_IDP[$seq]}"$'\n'; fi
            heads="$heads${REC_TITLEP[$seq]}"$'\n'
        done
        GIM_KINDS="${GIM_KINDS:+$GIM_KINDS }$k"
        printf -v "GIM_TARGET_$k" '%s' "$target"
        printf -v "GIM_HEADS_$k" '%s' "$heads"
    done

    # 4. kind preselected when $default matches nothing (e.g. GRUB_DEFAULT=saved
    #    with no saved entry yet = entry 0): the kind of entry 0, else linux.
    GIM_FALLBACK_KIND=""
    for seq in "${REC_SEQ[@]}"; do
        if [ "${REC_DEPTH[$seq]}" = 0 ] && [ "${REC_IDX[$seq]}" = 0 ]; then
            case " $GIM_KINDS " in *" ${REC_KIND[$seq]} "*) GIM_FALLBACK_KIND="${REC_KIND[$seq]}" ;; esac
            break
        fi
    done
    if [ -z "$GIM_FALLBACK_KIND" ]; then
        case " $GIM_KINDS " in
            *" linux "*) GIM_FALLBACK_KIND=linux ;;
            *)           GIM_FALLBACK_KIND="${GIM_KINDS%% *}" ;;
        esac
    fi
    GIM_LAYOUT="$(printf '%s' "$GIM_KINDS" | tr ' ' '-')"
    return 0
}

# Is record $1 nested (at any depth) inside submenu record $2?
gim_is_descendant() {
    local p="${REC_PARENT[$1]}"
    while [ -n "$p" ] && [ "$p" != 0 ]; do
        [ "$p" = "$2" ] && return 0
        p="${REC_PARENT[$p]}"
    done
    return 1
}

# GRUB "default" path of an entry: ids if every level has one, else titles.
gim_entry_path() {
    if [ "${REC_IDP[$1]}" != - ]; then printf '%s' "${REC_IDP[$1]}"
    else printf '%s' "${REC_TITLEP[$1]}"; fi
}

# Classify one entry record. Order matters: a Windows chainloader wins over
# anything else; Linux needs a real kernel from this installation.
gim_entry_kind() {
    local s="$1"
    local classes=" ${REC_CLASSES[$s]} " kernel="${REC_KERNEL[$s]}" chain="${REC_CHAIN[$s]}"
    local lchain lkernel kbase
    if [ "${REC_PRES[$s]}" = F ]; then echo absent; return; fi
    lchain="$(printf '%s' "$chain" | tr 'A-Z' 'a-z')"
    lkernel="$(printf '%s' "$kernel" | tr 'A-Z' 'a-z')"
    if [ "$chain" != - ]; then
        case "$lchain" in
            */efi/microsoft/boot/bootmgfw.efi|efi/microsoft/boot/bootmgfw.efi) echo windows; return ;;
        esac
        case "$classes" in
            *" windows "*) echo windows; return ;;
        esac
    fi
    if [ "$kernel" != - ]; then
        case "$classes" in *" memtest "*) echo other; return ;; esac
        case "$lkernel" in *mt86*|*memtest*) echo other; return ;; esac
        kbase="${lkernel##*/}"
        case "$kbase" in
            vmlinuz*|vmlinux*|bzimage*|kernel-*|linux-*) ;;
            *) echo other; return ;;
        esac
        # Entries generated by os-prober boot *another* installation: its own
        # icon (by name: class, title), or none unless FOREIGN_LINUX=true.
        if [ "${REC_SCRIPT[$s]}" = 30_os-prober ]; then
            if [ "$GIM_FOREIGN_LINUX" != true ]; then echo other; return; fi
            gim_os_kind "${REC_CLASSES[$s]} ${REC_TITLE[$s]}" || echo generic
            return
        fi
        echo linux; return
    fi
    echo other
}

# Human readable summary of the classification (for logs and detect-os.sh).
gim_report() {
    local seq indent
    for seq in "${REC_SEQ[@]}"; do
        indent=""
        local d="${REC_DEPTH[$seq]}"
        while [ "$d" -gt 0 ]; do indent="$indent  "; d=$((d - 1)); done
        printf '  %-8s %-7s %s%s [%s]\n' "${REC_KIND[$seq]}" "${REC_TYPE[$seq]}" "$indent" \
            "${REC_TITLE[$seq]}" "$(gim_entry_path "$seq")"
    done
}

# Machine readable results.
gim_print_results() {
    local k u n t list="windows linux"
    # Windows and Linux always (scripts rely on them), other kinds when found.
    for k in $GIM_KINDS; do case " $list " in *" $k "*) ;; *) list="$list $k" ;; esac; done
    for k in $list; do
        u="$(printf '%s' "$k" | tr 'a-z' 'A-Z')"
        case " $GIM_KINDS " in *" $k "*) n=1 ;; *) n=0 ;; esac
        eval "t=\${GIM_TARGET_$k:-}"
        printf '%s=%s\n' "$u" "$n"
        printf 'TARGET_%s=%q\n' "$u" "$t"
        eval "printf 'ENTRIES_%s=%s\n' \"\$u\" \"\$GIM_COUNT_$k\""
    done
    case " $GIM_KINDS " in
        *" windows "*) [ "$GIM_HANDOFF" = 1 ] && t=firmware || t=chainload ;;
        *)             t="" ;;
    esac
    printf 'WINDOWS_BOOT=%s\n' "$t"
    printf 'KINDS=%q\n' "$GIM_KINDS"
    printf 'MISSING_ICONS=%q\n' "${GIM_MISSING_ICONS:-}"
    printf 'LAYOUT=%s\n' "$GIM_LAYOUT"
    printf 'FALLBACK_KIND=%s\n' "$GIM_FALLBACK_KIND"
    printf 'ENTRIES_TOTAL=%s\nENTRIES_IGNORED=%s\nENTRIES_ABSENT=%s\n' \
        "$GIM_COUNT_TOTAL" "$GIM_COUNT_IGNORED" "$GIM_COUNT_ABSENT"
}

# ---------------------------------------------------------------------------
# Windows through the firmware (GRUB_ICON_MENU_WINDOWS_BOOT=firmware)
# ---------------------------------------------------------------------------
#
# BitLocker seals its key to TPM measurements of the boot chain (PCR 4 holds
# the hash of every boot application). Windows chainloaded by GRUB is measured
# as shim + GRUB + bootmgfw, Windows started by the firmware as bootmgfw only,
# so a chainloaded Windows asks for the recovery key. The Windows icon boots
# GIM_HANDOFF_ID instead: the signed Ubuntu kernel with handoff.img from the
# theme directory (handoff/init). It sets the one-time UEFI variable BootNext
# to the firmware's Windows Boot Manager entry and restarts, and the firmware
# starts Windows exactly like a normal Windows boot.
# chainload = the old behaviour: the icon boots os-prober's chainload entry.

GIM_HANDOFF_ID="gim-windows-handoff"
GIM_HANDOFF_TITLE="Windows Boot Manager (started by the UEFI firmware)"
GIM_EFI_GLOBAL="8be4df61-93ca-11d2-aa0d-00e098032b8c"
GIM_HANDOFF=0

# Boot#### number of the firmware's entry for \EFI\Microsoft\Boot\bootmgfw.efi.
# The device path stores the file name in UTF-16: without the zero bytes it
# reads as ASCII (handoff/init uses the same test).
gim_windows_bootnum() {
    local dir="${GIM_EFIVARS:-/sys/firmware/efi/efivars}" f n
    for f in "$dir"/Boot[0-9A-F][0-9A-F][0-9A-F][0-9A-F]-"$GIM_EFI_GLOBAL"; do
        [ -f "$f" ] || continue
        # (grep reads everything: no SIGPIPE when sourced under pipefail)
        if tr -d '\000' <"$f" 2>/dev/null | tr 'A-Z' 'a-z' | grep -F '\efi\microsoft\boot\bootmgfw.efi' >/dev/null; then
            n="${f##*/Boot}"
            printf '%s\n' "${n%%-*}"
            return 0
        fi
    done
    return 1
}

# Does kernel $1 carry an Authenticode signature (a PE certificate table)?
# Ubuntu's kernels do; shim refuses unsigned ones (e.g. mainline builds) when
# Secure Boot is on, and the Windows icon would only show an error.
gim_kernel_signed() {
    local f="$1" pe magic dir size
    pe="$(od -An -t u4 -j 60 -N 4 -- "$f" 2>/dev/null | tr -d ' ')"
    case "$pe" in ''|*[!0-9]*) return 1 ;; esac
    [ "$(od -An -t x1 -j "$pe" -N 4 -- "$f" 2>/dev/null | tr -d ' \n')" = 50450000 ] || return 1
    magic="$(od -An -t u2 -j $((pe + 24)) -N 2 -- "$f" 2>/dev/null | tr -d ' ')"
    case "$magic" in
        523) dir=$((pe + 24 + 112)) ;;      # PE32+: data directories
        267) dir=$((pe + 24 + 96)) ;;       # PE32
        *)   return 1 ;;
    esac
    size="$(od -An -t u4 -j $((dir + 4 * 8 + 4)) -N 4 -- "$f" 2>/dev/null | tr -d ' ')"
    case "$size" in ''|*[!0-9]*) return 1 ;; esac
    [ "$size" -gt 0 ]
}

# Kernel for the Windows icon: the newest signed kernel in /boot, so a newer
# unsigned kernel (mainline, self-built) cannot break the Windows icon with
# Secure Boot on. If no kernel is signed (or none can be read), the newest.
gim_handoff_kernel() {
    local k kernels newest=""
    kernels="$(for k in "${GIM_BOOT_DIR:-/boot}"/vmlinuz-*; do
        case "$k" in *.old|*.bak|*.dpkg-*|*~) continue ;; esac
        [ -f "$k" ] && printf '%s\n' "$k"
    done | sort -V -r)"
    while IFS= read -r k; do
        [ -n "$k" ] || continue
        [ -n "$newest" ] || newest="$k"
        if gim_kernel_signed "$k"; then printf '%s\n' "$k"; return 0; fi
    done <<<"$kernels"
    [ -z "$newest" ] || printf '%s\n' "$newest"
}

# Check everything the handoff entry needs; set GIM_HANDOFF_* (needs
# GIM_DEVICE_PREP / GIM_THEME_REL). Returns 1 with a warning otherwise.
gim_prepare_handoff() {
    local theme_dir="$1"
    if [ "$GIM_PLATFORM" != efi ]; then
        gim_warn "not booted in UEFI mode - no Windows icon"; return 1
    fi
    if [ ! -s "$theme_dir/handoff.img" ]; then
        gim_warn "$theme_dir/handoff.img missing - no Windows icon (run update.sh)"; return 1
    fi
    GIM_HANDOFF_BOOTNUM="$(gim_windows_bootnum)" || {
        gim_warn "the UEFI boot entries have no Windows Boot Manager - no Windows icon"; return 1
    }
    gim_prepare_handoff_kernel
}

# Kernel of every firmware handoff entry: sets GIM_HANDOFF_KERNEL_PREP/REL.
gim_prepare_handoff_kernel() {
    local kernel device
    [ -z "${GIM_HANDOFF_KERNEL_REL:-}" ] || return 0
    if [ -n "${GIM_TEST_DEVICE_PREP+x}" ]; then
        GIM_HANDOFF_KERNEL_PREP="$GIM_TEST_DEVICE_PREP"
        GIM_HANDOFF_KERNEL_REL="${GIM_TEST_HANDOFF_KERNEL:-/vmlinuz}"
        return 0
    fi
    kernel="$(gim_handoff_kernel)"
    if [ -z "$kernel" ] || ! is_path_readable_by_grub "$kernel"; then
        gim_warn "no kernel in /boot that GRUB can read - no icons for systems started by the firmware"; return 1
    fi
    device="$(${grub_probe:-grub-probe} --target=device "$kernel")" || return 1
    GIM_HANDOFF_KERNEL_PREP="$(prepare_grub_to_access_device $device)" || return 1
    GIM_HANDOFF_KERNEL_REL="$(make_system_path_relative_to_its_root "$kernel")" || return 1
}

# Icons in GRUB_ICON_MENU_ORDER first, then the others as they were found.
gim_order_kinds() {
    local k kinds=""
    for k in $GIM_ORDER $GIM_KINDS; do
        case " $GIM_KINDS " in *" $k "*) ;; *) continue ;; esac
        case " $kinds " in *" $k "*) continue ;; esac
        kinds="$kinds $k"
    done
    GIM_KINDS="${kinds# }"
    GIM_LAYOUT="$(printf '%s' "$GIM_KINDS" | tr ' ' '-')"
}

# The Windows icon boots the handoff entry (after gim_classify). Chainload
# entries still count as Windows when $default names one, but are never booted.
gim_use_handoff() {
    GIM_HANDOFF=1
    GIM_TARGET_windows="$GIM_HANDOFF_ID"
    GIM_HEADS_windows="${GIM_HEADS_windows:-}$GIM_HANDOFF_ID"$'\n'"$GIM_HANDOFF_TITLE"$'\n'
    GIM_COUNT_windows=$(( ${GIM_COUNT_windows:-0} + 1 ))
    case " $GIM_KINDS " in *" windows "*) ;; *) GIM_KINDS="$GIM_KINDS windows" ;; esac
    gim_order_kinds
}

# No icon for kind $1 (firmware mode without a working handoff: never fall
# back to chainloading Windows).
gim_drop_kind() {
    local k kinds=""
    for k in $GIM_KINDS; do [ "$k" = "$1" ] || kinds="$kinds $k"; done
    GIM_KINDS="${kinds# }"
    printf -v "GIM_TARGET_$1" '%s' ""
    printf -v "GIM_HEADS_$1" '%s' ""
    GIM_LAYOUT="$(printf '%s' "$GIM_KINDS" | tr ' ' '-')"
    if [ "$GIM_FALLBACK_KIND" = "$1" ]; then
        case " $GIM_KINDS " in
            *" linux "*) GIM_FALLBACK_KIND=linux ;;
            *)           GIM_FALLBACK_KIND="${GIM_KINDS%% *}" ;;
        esac
    fi
}

gim_emit_handoff() {
    cat <<EOF
# Windows icon: Windows Boot Manager started by the UEFI firmware, not by GRUB,
# so BitLocker sees a normal Windows boot. The kernel only runs handoff.img,
# which sets the one-time UEFI variable BootNext=Boot$GIM_HANDOFF_BOOTNUM and restarts.
EOF
    gim_emit_handoff_entry "$GIM_HANDOFF_ID" "$GIM_HANDOFF_TITLE" windows "$GIM_HANDOFF_BOOTNUM" ""
}

# gim_emit_handoff_entry ID TITLE CLASS BOOTNUM MATCH: a menu entry whose
# kernel + handoff.img set BootNext=Boot<BOOTNUM> and restart. MATCH (file of
# the boot entry, e.g. /efi/kali/shimx64.efi) is checked again by handoff/init;
# empty means Windows Boot Manager.
gim_emit_handoff_entry() {
    local id="$1" title="$2" class="$3" num="$4" match="$5" extra=""
    if [ -n "$match" ]; then extra=" gim.match=$match"; fi
    cat <<EOF
menuentry $(gim_q "$title") --class $class --class os --id $id {
  set gfxpayload=keep
EOF
    printf '%s\n' "$GIM_DEVICE_PREP" | sed -e '/^$/d' -e 's/^/  /'
    printf '  set gim_handoff="(${root})%s"\n' "$GIM_THEME_REL/handoff.img"
    # Without its initrd the kernel would just panic and restart: check first.
    cat <<'EOF'
  if [ -f "${gim_handoff}" ]; then
EOF
    printf '%s\n' "$GIM_HANDOFF_KERNEL_PREP" | sed -e '/^$/d' -e 's/^/    /'
    # fbcon=font: if handoff/init has to explain a problem, the text is
    # readable on a high-resolution screen (nothing is shown otherwise).
    printf '    linux %s gim.bootnext=%s%s quiet loglevel=0 panic=10 fbcon=font:TER16x32\n' \
        "$(gim_q "$GIM_HANDOFF_KERNEL_REL")" "$num" "$extra"
    cat <<'EOF'
    initrd "${gim_handoff}"
  else
    echo "grub-icon-menu: ${gim_handoff} is missing - nothing was started."
    echo "Use the firmware boot menu (F9 on HP laptops), and run update.sh in Ubuntu."
    sleep 10
  fi
}
EOF
}

# ---------------------------------------------------------------------------
# Other systems through the firmware
# ---------------------------------------------------------------------------
#
# Linux distributions (and others) installed next to Ubuntu normally create
# their own UEFI boot entry with their own signed boot loader (Kali:
# \EFI\kali\shimx64.efi). The icon of such a system boots the same handoff as
# the Windows icon, with BootNext set to that entry: the firmware starts the
# system exactly as from its boot menu (F9), so Secure Boot keeps working and
# nothing depends on this GRUB being able to boot a foreign kernel.

# Icon name of a system from words in its name, EFI directory, os-prober
# class or menu title (case and punctuation are ignored). Derivatives come
# before their base (kubuntu before ubuntu, manjaro before arch).
gim_os_kind() {
    local t
    t=" $(printf '%s' "$*" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' ' ' | tr -s ' ') "
    case "$t" in
        *" kubuntu "*)                              echo kubuntu ;;
        *" xubuntu "*)                              echo xubuntu ;;
        *" lubuntu "*)                              echo lubuntu ;;
        *" ubuntu mate "*|*" ubuntumate "*)         echo ubuntumate ;;
        *" kde neon "*|*" kdeneon "*|*" neon "*)    echo kdeneon ;;
        *" linux mint "*|*" linuxmint "*|*" mint "*|*" lmde "*) echo linuxmint ;;
        *" pop os "*|*" popos "*|*" pop "*)         echo popos ;;
        *" elementary "*)                           echo elementary ;;
        *" zorin "*)                                echo zorin ;;
        *" kali "*)                                 echo kali ;;
        *" parrot "*)                               echo parrot ;;
        *" mx "*|*" mxlinux "*)                     echo mxlinux ;;
        *" deepin "*)                               echo deepin ;;
        *" manjaro "*|*" manjarolinux "*)           echo manjaro ;;
        *" endeavouros "*|*" endeavour "*)          echo endeavouros ;;
        *" garuda "*)                               echo garuda ;;
        *" artix "*)                                echo artix ;;
        *" cachyos "*)                              echo cachyos ;;
        *" arch "*|*" archlinux "*)                 echo arch ;;
        *" fedora "*)                               echo fedora ;;
        *" almalinux "*|*" alma "*)                 echo almalinux ;;
        *" rocky "*)                                echo rocky ;;
        *" centos "*)                               echo centos ;;
        *" red hat "*|*" redhat "*|*" rhel "*)      echo redhat ;;
        *" opensuse "*|*" suse "*|*" sles "*)       echo opensuse ;;
        *" debian "*)                               echo debian ;;
        *" ubuntu "*)                               echo ubuntu ;;
        *" gentoo "*)                               echo gentoo ;;
        *" nixos "*)                                echo nixos ;;
        *" void "*)                                 echo void ;;
        *" alpine "*)                               echo alpine ;;
        *" slackware "*)                            echo slackware ;;
        *" solus "*)                                echo solus ;;
        *" qubes "*)                                echo qubes ;;
        *" freebsd "*)                              echo freebsd ;;
        *" android "*|*" bliss "*|*" primeos "*)    echo android ;;
        *) return 1 ;;
    esac
}

# Name shown in the full (ESC) menu.
gim_os_name() {
    case "$1" in
        kali) echo "Kali Linux" ;;         linuxmint) echo "Linux Mint" ;;
        arch) echo "Arch Linux" ;;         debian) echo "Debian" ;;
        fedora) echo "Fedora" ;;           opensuse) echo "openSUSE" ;;
        manjaro) echo "Manjaro" ;;         ubuntu) echo "Ubuntu" ;;
        popos) echo "Pop!_OS" ;;           elementary) echo "elementary OS" ;;
        zorin) echo "Zorin OS" ;;          endeavouros) echo "EndeavourOS" ;;
        centos) echo "CentOS" ;;           rocky) echo "Rocky Linux" ;;
        almalinux) echo "AlmaLinux" ;;     redhat) echo "Red Hat Enterprise Linux" ;;
        gentoo) echo "Gentoo" ;;           nixos) echo "NixOS" ;;
        mxlinux) echo "MX Linux" ;;        kubuntu) echo "Kubuntu" ;;
        xubuntu) echo "Xubuntu" ;;         lubuntu) echo "Lubuntu" ;;
        ubuntumate) echo "Ubuntu MATE" ;;  garuda) echo "Garuda Linux" ;;
        void) echo "Void Linux" ;;         alpine) echo "Alpine Linux" ;;
        slackware) echo "Slackware" ;;     solus) echo "Solus" ;;
        deepin) echo "deepin" ;;           parrot) echo "Parrot OS" ;;
        qubes) echo "Qubes OS" ;;          freebsd) echo "FreeBSD" ;;
        kdeneon) echo "KDE neon" ;;        artix) echo "Artix Linux" ;;
        cachyos) echo "CachyOS" ;;         android) echo "Android" ;;
        *) echo "$1" ;;
    esac
}

# UINT16 values of an EFI variable's data as 4 hex digits (BootOrder).
gim_efi_u16_list() {
    od -An -v -tx1 -j4 -- "$1" 2>/dev/null | tr -s ' \n' ' ' |
        awk '{ for (i = 1; i + 1 <= NF; i += 2) printf "%s%s\n", toupper($(i + 1)), toupper($i) }'
}

# gim_firmware_systems: other systems in the UEFI boot entries, one line per
# system: "KIND NUM MATCH NAME" (BootOrder order, first entry per kind).
# Skipped: inactive entries, entries without a file (USB stick, network,
# "Internal Hard Disk"), Windows (own icon), this Ubuntu (\EFI\ubuntu\, which
# Linux Mint, Zorin and elementary share; and the entry this system was
# started from), the fallback loader \EFI\BOOT\, and everything that is not
# a known system (vendor tools, rEFInd, ...).
gim_firmware_systems() {
    local dir="${GIM_EFIVARS:-/sys/firmware/efi/efivars}" g="$GIM_EFI_GLOBAL"
    local nums n f data desc path match kind current="" seen=" "
    [ -d "$dir" ] || return 0
    if [ -f "$dir/BootCurrent-$g" ]; then current="$(gim_efi_u16_list "$dir/BootCurrent-$g" | head -n1)"; fi
    nums="$(gim_efi_u16_list "$dir/BootOrder-$g" 2>/dev/null)"
    nums="$nums"$'\n'"$(for f in "$dir"/Boot[0-9A-F][0-9A-F][0-9A-F][0-9A-F]-"$g"; do
        [ -f "$f" ] || continue; n="${f##*/Boot}"; printf '%s\n' "${n%%-*}"; done)"
    for n in $nums; do
        case "$seen" in *" n$n "*) continue ;; esac
        seen="$seen n$n "
        f="$dir/Boot$n-$g"
        [ -f "$f" ] || continue
        [ "$n" != "$current" ] || continue
        # efivarfs: 4 bytes variable attributes, then EFI_LOAD_OPTION:
        # Attributes (UINT32, bit 0 = active), FilePathListLength (UINT16),
        # Description (UTF-16, NUL-terminated), device path.
        data="$(od -An -v -tu1 -N 1024 -- "$f" 2>/dev/null)" || continue
        desc="$(printf '%s\n' "$data" | awk '{ for (i = 1; i <= NF; i++) b[c++] = $i }
            END { if (c < 10 || b[4] % 2 == 0) exit 1
                  for (i = 10; i + 1 < c; i += 2) {
                      if (b[i] == 0 && b[i + 1] == 0) break
                      s = s ((b[i + 1] == 0 && b[i] >= 32 && b[i] < 127) ? sprintf("%c", b[i]) : "?")
                  }
                  print s }')" || continue
        path="$(tr -d '\000' <"$f" 2>/dev/null | LC_ALL=C grep -aoi '\\efi\\[a-z0-9_.+-]*\\[a-z0-9_.+\\-]*\.efi' | head -n1)"
        [ -n "$path" ] || continue
        match="$(printf '%s' "$path" | tr 'A-Z\\' 'a-z/')"
        case "$match" in
            /efi/microsoft/*|/efi/ubuntu/*|/efi/boot/*) continue ;;
        esac
        kind="$(gim_os_kind "$desc ${match#/efi/}")" || continue
        case "$seen" in *" k$kind "*) continue ;; esac
        seen="$seen k$kind "
        printf '%s %s %s %s\n' "$kind" "$n" "$match" "$(gim_os_name "$kind")"
    done
}

# gim_use_firmware KIND NUM MATCH NAME: the icon of KIND boots its firmware
# entry (also when os-prober found the same system: its own boot loader
# keeps Secure Boot working).
GIM_FW_ENTRIES=""
gim_use_firmware() {
    local k="$1" id="gim-$1-handoff" title="$4 (started by the UEFI firmware)"
    printf -v "GIM_TARGET_$k" '%s' "$id"
    eval "GIM_HEADS_$k=\"\${GIM_HEADS_$k:-}\$id\"\$'\\n'\"\$title\"\$'\\n'"
    eval "GIM_COUNT_$k=\$(( \${GIM_COUNT_$k:-0} + 1 ))"
    case " $GIM_KINDS " in *" $k "*) ;; *) GIM_KINDS="${GIM_KINDS:+$GIM_KINDS }$k" ;; esac
    if [ -n "$2" ]; then
        GIM_FW_ENTRIES="$GIM_FW_ENTRIES$k $2 $3 $title"$'\n'
    fi
    gim_order_kinds
}

# Firmware entries of the other systems (also for kinds without an icon:
# they are still in the full menu).
gim_emit_firmware_entries() {
    local k n m t
    while read -r k n m t; do
        [ -n "$k" ] || continue
        echo "# $t: firmware boot entry Boot$n ($m), started like the Windows icon."
        gim_emit_handoff_entry "gim-$k-handoff" "$t" "$k" "$n" "$m"
    done <<<"$GIM_FW_ENTRIES"
}

# ---------------------------------------------------------------------------
# GRUB script emitter
# ---------------------------------------------------------------------------

# Quote a string for GRUB script (same rule as grub_quote).
gim_q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# Print the GRUB snippet. Needs gim_classify results plus:
#   GIM_DEVICE_PREP  lines that set $root to the theme partition
#   GIM_THEME_REL    theme directory relative to that partition's root
gim_emit() {
    local k i=0 n=0 title
    for k in $GIM_KINDS; do n=$((n + 1)); done
    cat <<EOF
# grub-icon-menu $GIM_VERSION - icon-only boot chooser.
# Detected (internal): $GIM_KINDS - icons: $n; entries ignored by the chooser: $GIM_COUNT_IGNORED.
# The complete standard menu above is untouched: press ESC in the chooser.
# Disable: GRUB_ICON_MENU=false in /etc/default/grub.d/99-grub-icon-menu.cfg, then update-grub.
EOF
    if [ "$GIM_HANDOFF" = 1 ]; then gim_emit_handoff; fi
    gim_emit_firmware_entries
    if [ -n "${GIM_MISSING_ICONS:-}" ]; then
        echo "# Detected without icon (run update.sh): $GIM_MISSING_ICONS"
    fi
    echo "function gim_entries {"
    # GRUB menus do not wrap around. To make the arrow cycle Windows <-> Tux
    # endlessly in both directions, the icon sequence is repeated and the
    # preselected entry is taken from the middle copy (only icon entries
    # exist here: memtest, advanced options etc. never get the arrow).
    local copies=1 c
    if [ "$n" -gt 1 ]; then copies=41; fi
    GIM_MID=$((copies / 2))
    for (( c = 0; c < copies; c++ )); do
    i=0
    for k in $GIM_KINDS; do
        i=$((i + 1))
        # Neutral title on purpose: GRUB prints "Booting \`<title>'" when the
        # countdown expires, and no OS name may appear on screen.
        # The body re-reads grub.cfg directly (no helper function): GRUB
        # refuses to redefine a function that is still executing, and the
        # re-read grub.cfg defines all functions again.
        title="icon $i"
        printf "  menuentry %s --class gim-%s-%s --id gim-%s-%s {\n" \
            "$(gim_q "$title")" "$GIM_LAYOUT" "$((i - 1))" "$k" "$c"
        cat <<EOF
    if [ -n "\${gim_target_$k}" ]; then
      unset chosen
      set gim_target="\${gim_target_$k}"
      export gim_target
      configfile "\${gim_cfg}"
    fi
  }
EOF
    done
    done
    echo "}"
    cat <<EOF
if [ -n "\${gim_target}" ]; then
  # Second pass: an icon was chosen. Boot its standard entry immediately.
  # 00_header re-initialised gfxterm: show the theme's background again while
  # the entry loads (the picture with a transparent console, or white).
  set default="\${gim_target}"
  unset gim_target
  # (GRUB script has no && or ||.)
  set color_normal=black/white
  if [ -n "\${gim_bg}" ]; then
    if background_image "\${gim_bg}"; then set color_normal=${GIM_CONSOLE_FG:-white}/black; fi
  fi
  clear
  set timeout_style=hidden
  set timeout=0
elif [ "\${boot_once}" = true ]; then
  # One-time boot request (grub-reboot, initrd fallback): honour it silently.
  set timeout_style=hidden
  set timeout=0
else
  set gim_saved_root="\${root}"
EOF
    printf '%s\n' "$GIM_DEVICE_PREP" | sed -e '/^$/d' -e 's/^/  /'
    cat <<EOF
  set gim_dir="(\${root})$GIM_THEME_REL"
  set root="\${gim_saved_root}"
  unset gim_saved_root
  unset gim_bg
  if [ -f "\${gim_dir}/background.png" ]; then set gim_bg="\${gim_dir}/background.png"; fi
  if [ -f "\${gim_dir}/chooser.cfg" ]; then
    set gim_cfg="\${config_file}"
    if [ -z "\${gim_cfg}" ]; then set gim_cfg="\${prefix}/grub.cfg"; fi
    # The preselected icon follows the normal default entry (\$default holds
    # GRUB_DEFAULT, saved_entry or next_entry; empty means entry 0).
    set gim_def="\${default}"
    if [ -z "\${gim_def}" ]; then set gim_def=0; fi
    set gim_kind=""
EOF
    for k in $GIM_KINDS; do
        local heads h
        eval "heads=\$GIM_HEADS_$k"
        while IFS= read -r h; do
            [ -n "$h" ] || continue
            printf '    if [ "${gim_def}" = %s ]; then set gim_kind=%s; fi\n' "$(gim_q "$h")" "$k"
        done <<<"$heads"
    done
    for k in $GIM_KINDS; do
        local t
        eval "t=\$GIM_TARGET_$k"
        # The icon boots the default entry when that is of its kind (e.g. a
        # pinned older kernel), otherwise the kind's primary entry. Not for
        # the Windows handoff: the default may be a chainload entry.
        printf '    set gim_target_%s=%s\n' "$k" "$(gim_q "$t")"
        if [ "$k" != windows ] || [ "$GIM_HANDOFF" != 1 ]; then
            printf '    if [ "${gim_kind}" = %s ]; then set gim_target_%s="${gim_def}"; fi\n' "$k" "$k"
        fi
    done
    cat <<EOF
    if [ -z "\${gim_kind}" ]; then set gim_kind=$GIM_FALLBACK_KIND; fi
    set gim_selected="gim-\${gim_kind}-$GIM_MID"
    set gim_timeout=$GIM_TIMEOUT
EOF
    if [ "$GIM_TIMEOUT" != -1 ]; then
        printf '    if [ "${recordfail}" = 1 ]; then set gim_timeout=%s; fi\n' "$GIM_RECORDFAIL_TIMEOUT"
    fi
    cat <<EOF
    export gim_dir
    export gim_bg
    export gim_cfg
    export gim_selected
    export gim_timeout
EOF
    for k in $GIM_KINDS; do
        printf '    export gim_target_%s\n' "$k"
    done
    cat <<EOF
    # Black on white console text, so GRUB's text area (shown while an
    # entry loads, or for the c and e keys) blends into the white theme.
    set color_normal=black/white
    configfile "\${gim_dir}/chooser.cfg"
    # Only reached when ESC was pressed in the chooser: show the complete
    # standard menu (with entry names) and wait for the user.
    unset timeout
    set timeout_style=menu
  fi
fi
EOF
}

# ---------------------------------------------------------------------------
# Main (grub-mkconfig mode)
# ---------------------------------------------------------------------------

# The menu generated so far. Normally our stdout is grub.cfg.new, written by
# grub-mkconfig; if not (e.g. "grub-mkconfig" printing to a terminal), run
# the other helper scripts again to get the same text.
gim_current_menu() {
    local out="/proc/$$/fd/1"
    if [ -n "${GIM_INPUT_CFG:-}" ]; then
        cat -- "$GIM_INPUT_CFG"; return
    fi
    if [ -f "$out" ] && [ -r "$out" ] && grep -q '^### BEGIN .*/00_header ###$' "$out" 2>/dev/null; then
        cat -- "$out"; return
    fi
    if [ "$GIM_RESCAN" != true ]; then return 1; fi
    gim_warn "output is not a file; re-running the other /etc/grub.d scripts to read the menu"
    local dir s
    dir="$(dirname -- "$0")"
    for s in "$dir"/*; do
        case "$s" in *~|*/\#*\#|*grub_icon_menu*) continue ;; esac
        if type grub_file_is_not_garbage >/dev/null 2>&1; then
            grub_file_is_not_garbage "$s" || continue
        fi
        [ -x "$s" ] && [ -f "$s" ] || continue
        echo "### BEGIN $s ###"
        GIM_RESCANNING=1 "$s" 2>/dev/null || true
        echo "### END $s ###"
    done
}

# Where GRUB finds the theme directory $1: sets GIM_DEVICE_PREP (lines that
# set $root to its partition) and GIM_THEME_REL (path on that partition).
gim_theme_location() {
    local theme_dir="$1" device
    case "$theme_dir" in
        /*) ;;
        *) gim_warn "GRUB_ICON_MENU_THEME_DIR must be absolute"; return 1 ;;
    esac
    if ! printf '%s' "$theme_dir" | grep -Eq '^[A-Za-z0-9/._+-]+$'; then
        gim_warn "unsupported characters in theme path '$theme_dir'"; return 1
    fi
    if [ -n "${GIM_TEST_DEVICE_PREP+x}" ]; then
        GIM_DEVICE_PREP="$GIM_TEST_DEVICE_PREP"
        GIM_THEME_REL="${GIM_TEST_THEME_REL:-$theme_dir}"
        return 0
    fi
    if ! is_path_readable_by_grub "$theme_dir/$GIM_THEME_MARKER"; then
        gim_warn "GRUB cannot read $theme_dir"; return 1
    fi
    device="$(${grub_probe:-grub-probe} --target=device "$theme_dir")" || return 1
    GIM_DEVICE_PREP="$(prepare_grub_to_access_device $device)" || return 1
    GIM_THEME_REL="$(make_system_path_relative_to_its_root "$theme_dir")" || return 1
}

# GRUB_ICON_MENU=false: no icon chooser, only the standard menu. Windows keeps
# its BitLocker-safe entry (the firmware handoff), and the menu is shown like
# os-prober shows it: Ubuntu hides a menu that lists only Ubuntu, which would
# leave no way to start Windows from GRUB.
gim_main_plain() {
    echo "# grub-icon-menu: icon chooser disabled (GRUB_ICON_MENU=$GIM_ENABLED); standard menu"
    [ "$GIM_WINDOWS_BOOT" = firmware ] || return 0
    gim_detect_platform
    gim_theme_location "$GIM_THEME_DIR" || return 0
    gim_plain_firmware_systems
    case " $GIM_ORDER " in
        *" windows "*) if gim_prepare_handoff "$GIM_THEME_DIR"; then GIM_HANDOFF=1; fi ;;
    esac
    [ "$GIM_HANDOFF" = 1 ] || [ -n "$GIM_FW_ENTRIES" ] || return 0
    if [ "$GIM_HANDOFF" = 1 ]; then gim_emit_handoff; fi
    gim_emit_firmware_entries
    cat <<EOF
# Show the menu, so that the Windows entry can be chosen.
if [ "\${boot_once}" != true ]; then
  set timeout_style=menu
EOF
    if [ "$GIM_TIMEOUT" = -1 ]; then
        printf '  if [ "${timeout}" = 0 ]; then unset timeout; fi\n'
    else
        printf '  if [ "${timeout}" = 0 ]; then set timeout=%s; fi\n' "$GIM_TIMEOUT"
    fi
    echo "fi"
    if [ "$GIM_HANDOFF" = 1 ]; then
        echo "Windows entry: started by the UEFI firmware (BootNext=Boot$GIM_HANDOFF_BOOTNUM)" >&2
    fi
}

# Firmware entries of other systems (GIM_FW_ENTRIES), if the handoff can run.
gim_plain_firmware_systems() {
    local k n m t
    [ "$GIM_FIRMWARE_SYSTEMS" = true ] && [ "$GIM_PLATFORM" = efi ] || return 0
    [ -s "$GIM_THEME_DIR/handoff.img" ] || return 0
    while read -r k n m t; do
        [ -n "$k" ] || continue
        gim_prepare_handoff_kernel || return 0
        GIM_FW_ENTRIES="$GIM_FW_ENTRIES$k $n $m $t (started by the UEFI firmware)"$'\n'
        echo "Found $t: started by the UEFI firmware (BootNext=Boot$n)" >&2
    done < <(gim_firmware_systems)
}

gim_main() {
    gim_load_config || { gim_warn "cannot read configuration"; return 1; }
    case "$GIM_ENABLED" in
        true|1|yes) ;;
        *) gim_main_plain; return 0 ;;
    esac
    gim_detect_platform

    local theme_dir="$GIM_THEME_DIR"
    if [ ! -f "$theme_dir/chooser.cfg" ] || [ ! -f "$theme_dir/icon-menu.txt" ]; then
        gim_warn "theme not found in $theme_dir - icon menu not generated (run update.sh)"
        echo "# grub-icon-menu: theme missing in $theme_dir; standard menu only"
        return 0
    fi

    local menu records
    menu="$(gim_current_menu)" || { gim_warn "cannot read the generated menu"; return 1; }
    records="$(printf '%s\n' "$menu" | gim_parse)" || { gim_warn "parser failed"; return 1; }
    gim_classify <<<"$records" || return 1

    gim_theme_location "$theme_dir" || { gim_warn "icon menu not generated"; return 1; }
    # Console colour over a background picture (written by generate-assets.sh).
    GIM_CONSOLE_FG="$(sed -n 's/^CONSOLE_FG=//p' "$theme_dir/$GIM_THEME_MARKER" 2>/dev/null | tail -n1)"
    case "$GIM_CONSOLE_FG" in black|white) ;; *) GIM_CONSOLE_FG=white ;; esac

    if [ "$GIM_WINDOWS_BOOT" = firmware ]; then
        case " $GIM_ORDER " in
            *" windows "*)
                if gim_prepare_handoff "$theme_dir"; then gim_use_handoff; else gim_drop_kind windows; fi ;;
        esac
        # Other systems with their own UEFI boot entry.
        if [ "$GIM_FIRMWARE_SYSTEMS" = true ] && [ "$GIM_PLATFORM" = efi ] && [ -s "$theme_dir/handoff.img" ]; then
            local fk fn fm ft
            while read -r fk fn fm ft; do
                [ -n "$fk" ] || continue
                gim_prepare_handoff_kernel || break
                gim_use_firmware "$fk" "$fn" "$fm" "$ft"
                echo "Found $ft: started by the UEFI firmware (BootNext=Boot$fn)" >&2
            done < <(gim_firmware_systems)
        fi
    fi
    gim_order_kinds

    # Icons exist for the kinds the theme was built for (its ORDER). A newly
    # installed system gets its icon with the next update.sh; until then it
    # is only in the full menu (ESC).
    local have k missing="" n=0
    have="$(sed -n 's/^ORDER=//p' "$theme_dir/$GIM_THEME_MARKER" 2>/dev/null | tail -n1)"
    for k in $GIM_KINDS; do
        n=$((n + 1))
        case " $have " in
            *" $k "*) [ "$n" -le "$GIM_MAX_ICONS" ] && continue ;;
        esac
        missing="$missing $k"
    done
    for k in $missing; do gim_drop_kind "$k"; done
    GIM_MISSING_ICONS="${missing# }"
    if [ -n "$GIM_MISSING_ICONS" ]; then
        gim_warn "found without an icon yet: $GIM_MISSING_ICONS - run: sudo ./update.sh (they are in the ESC menu)"
    fi

    if [ -z "$GIM_KINDS" ]; then
        gim_warn "no Windows or Ubuntu entries found - icon menu not generated"
        echo "# grub-icon-menu: no supported boot entries detected; standard menu only"
        return 0
    fi
    # Every icon of this layout must exist, otherwise GRUB would show an
    # empty menu row. Assets are pre-generated for every layout by update.sh.
    local i=0 k
    for k in $GIM_KINDS; do
        if [ ! -f "$theme_dir/icons/gim-$GIM_LAYOUT-$i.png" ]; then
            gim_warn "missing icon gim-$GIM_LAYOUT-$i.png - icon menu not generated (run update.sh)"
            echo "# grub-icon-menu: icons for layout '$GIM_LAYOUT' missing; standard menu only"
            return 0
        fi
        i=$((i + 1))
    done

    echo "Found icon menu entries: $GIM_KINDS" >&2
    if [ "$GIM_HANDOFF" = 1 ]; then
        echo "Windows icon: started by the UEFI firmware (BootNext=Boot$GIM_HANDOFF_BOOTNUM)" >&2
    fi
    gim_emit
}

if [ "${GIM_HOOK_LIB:-0}" != 1 ]; then
    # Never recurse while gim_current_menu re-runs the helper scripts.
    [ "${GIM_RESCANNING:-0}" = 1 ] && exit 0
    if [ -z "${GIM_TEST_DEVICE_PREP+x}" ]; then
        pkgdatadir="${pkgdatadir:-/usr/share/grub}"
        # shellcheck source=/dev/null
        . "$pkgdatadir/grub-mkconfig_lib" || { echo "# grub-icon-menu: grub-mkconfig_lib missing"; exit 0; }
    fi
    if gim_output="$(gim_main)"; then
        printf '%s\n' "$gim_output"
    else
        echo "# grub-icon-menu: not generated (error); standard menu unchanged"
        gim_warn "error - icon menu not generated, the standard GRUB menu is unchanged"
    fi
    exit 0
fi
